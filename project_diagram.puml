@startuml
skinparam packageStyle rectangle
skinparam roundcorner 0
skinparam shadowing false
skinparam ArrowColor #34495E
skinparam ArrowThickness 1.2
skinparam classFontSize 16
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam tightVSpacing true
skinparam linetype ortho

' ===== ΠΟΛΥ ΜΙΚΡΟ MENU ΠΑΝΩ ΠΑΝΩ =====
skinparam padding 1
skinparam packagePadding 1
skinparam packageMargin 1
rectangle "menus" #FAD7A0 {
    class UserIo {
        + getString(prompt)
        + getInt(prompt)
        + showMessage(message)
        + exit()
    }
    class ConsoleIo {
        + getString(message)
        + getInt(message)
        + showMessage(message)
        + exit()
    }
    class Menu {
        + showMenu(message, optionsCount)
        + handleChoice(choice)
    }
    class MainMenu {
        + show()
        + handleChoice(choice)
    }
    class YearMenu {
        + show()
        + handleChoice(option)
    }

    ' Κοντά μεταξύ τους
    UserIo -[hidden]-> ConsoleIo
    ConsoleIo -[hidden]-> Menu
    Menu -[hidden]-> MainMenu
    MainMenu -[hidden]-> YearMenu
}

' ===== GUI =====
skinparam padding 5
skinparam packagePadding 10
skinparam packageMargin 10
package "GUI" #AED6F1 {
    class GoverLensApp {
        • main()
        • createAndShowGUI()
        • createWelcomePanel()
        • createProjectSelectionPanel()
        • createYearSelectionPanel()
        • createActionSelectionPanel()
    }

    class RoundedBorder {
        • paintBorder()
        • getBorderInsets(): Insets
        • isBorderOpaque(): boolean
    }

    class ImagePanelHelper as " " {
        • GoverLensLogo.jpg
        • BackroundPhoto.jpg
    }
}

' ===== DAO =====
package "DAO" #F9E79F {
    class CashFlow {
        • getId()
        • setId()
        • getAmount()
        • setAmount()
    }

    class CashFlowDao {
        • selectCashFlow()
        • addCashFlow()
        • updateCashFlow()
        • deleteCashFlow()
    }

    class Foreis {
        • getId()
        • setId()
        • getTotal()
        • setTotal()
    }

    class ForeisDao {
        • selectForeis()
        • addForeis()
        • updateForeis()
        • deleteForeis()
    }
}

' ===== Database =====
package "Database" #A9DFBF {
    class DatabaseSetup {
        • setURL()
        • setDatabase()
        • resetTables()
        • cleanTables()
        • getConnection(): Connection
    }

    class DataImporter {
        • setURL()
        • importer()
        • insertForeisFromCsv()
        • insertCashflowsFromCsv()
    }
}

' ===== TESTS =====
package "Tests" #D2B4DE {
    class CashFlowTest
    class CashFlowDaoTest
    class ForeisTest
    class ForeisDaoTest
    class DataImporterTest
    class DatabaseSetupTest
}

' ===== ΟΜΑΔΟΠΟΙΗΣΗ ΓΙΑ COMPACT =====
CashFlowTest -[hidden]-> CashFlowDaoTest
ForeisTest -[hidden]-> ForeisDaoTest
DataImporterTest -[hidden]-> DatabaseSetupTest

' ===== ΣΥΝΔΕΣΕΙΣ =====
Menu --> GUI
GoverLensApp --> DAO
GoverLensApp --> Database

CashFlowTest --> CashFlow
CashFlowDaoTest --> CashFlowDao
ForeisTest --> Foreis
ForeisDaoTest --> ForeisDao
DataImporterTest --> DataImporter
DatabaseSetupTest --> DatabaseSetup
@enduml
