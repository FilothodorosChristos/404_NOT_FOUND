@startuml
skinparam packageStyle rectangle
skinparam roundcorner 0
skinparam shadowing false
skinparam ArrowColor #34495E
skinparam ArrowThickness 1.2
skinparam classFontSize 14
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam tightVSpacing true
skinparam linetype ortho

' ===== MENUS =====
package "menus" #FAD7A0 {

    class UserIo {
        + getString(prompt)
        + getInt(prompt)
        + showMessage(message)
        + exit()
    }

    class ConsoleIo {
        + getString(message)
        + getInt(message)
        + showMessage(message)
        + exit()
    }

    ConsoleIo ..|> UserIo

    abstract class Menu {
        + showMenu(message, optionsCount)
        + handleChoice(choice)
    }

    class MainMenu {
        + show()
        + handleChoice(choice)
    }

    class YearMenu {
        + show()
        + handleChoice(choice)
    }

    class ActionsMenu {
        + show()
        + handleChoice(choice)
    }

    MainMenu --|> Menu
    YearMenu --|> Menu
    ActionsMenu --|> Menu
}

' ===== GUI =====
package "GUI" #AED6F1 {
    skinparam classPadding 20
    skinparam classFontSize 14

    class GoverLensApp {
        + createAndShowGUI()
        + createWelcomePanel()
        + createProjectSelectionPanel()
        + createYearSelectionPanel()
        + createActionSelectionPanel()
        + handleAction(action)
    }
}

' ===== DAO =====
package "DAO" #F9E79F {

    class CashFlow {
        + getId()
        + setId()
        + getAmount()
        + setAmount()
        + getYear_id()
        + setYear_id()
        + getType()
        + setType()
        + getName()
        + setName()
    }

    class CashFlowDao {
        + selectAllCashFlows()
        + addCashFlow()
        + updateCashFlow()
        + deleteCashFlow()
    }

    class Foreis {
        + getId()
        + setId()
        + getTotal()
        + setTotal()
        + getYear_id()
        + setYear_id()
        + getName()
        + setName()
    }

    class ForeisDao {
        + selectAllForeis()
        + addForeis()
        + updateForeis()
        + deleteForeis()
    }

    CashFlowDao --> CashFlow
    ForeisDao --> Foreis
}

' ===== DATABASE =====
package "Database" #A9DFBF {

    class DatabaseSetup {
        + setURL(url)
        + setDatabase()
        + cleanTables()
        + resetTables()
        + getConnection()
    }

    class DataImporter {
        + setURL(url)
        + importer()
        + insertForeisFromCsv(filename)
        + insertCashflowsFromCsv(filename, type)
    }

    CashFlowDao --> DatabaseSetup
    ForeisDao --> DatabaseSetup
    DataImporter --> DatabaseSetup
}

' ===== TESTS =====
package "Tests" #D2B4DE {

    class CashFlowTest {
        + testConstructorAndGetters()
        + testSetters()
        + testToString()
    }

    class CashFlowDaoTest {
        + setupDatabase()
        + init()
        + testAddAndSelectCashFlow()
        + testUpdateCashFlow()
        + testDeleteCashFlow()
        + restoreDatabaseURL()
    }

    class ForeisTest {
        + testConstructorAndGetters()
        + testSettersAndGetters()
        + testToString()
    }

    class ForeisDaoTest {
        + setupDatabase()
        + init()
        + testAddAndSelectForeis()
        + testUpdateForeis()
        + testDeleteForeis()
        + restoreDatabaseURL()
    }

    class DataImporterTest {
        + setupTestUrl()
        + restoreRealUrl()
        + setupDatabaseSchema()
        + insertForeisFromCsv_ShouldInsertValidRowsAndSkipInvalid()
        + insertCashflowsFromCsv_ShouldInsertValidRowsAndSkipInvalid()
        + insertForeisFromCsv_ShouldThrowFileNotFoundException()
    }

    class DatabaseSetupTest {
        + setup()
        + cleanTables()
        + teardownClass()
        + testSetDatabase_CreatesTables()
        + testCleanTables_DeletesTables()
        + testResetTables_RecreatesTables()
    }

    ' Dependencies (tests depend on classes)
    CashFlowTest ..> CashFlow
    CashFlowDaoTest ..> CashFlowDao
    ForeisTest ..> Foreis
    ForeisDaoTest ..> ForeisDao
    DataImporterTest ..> DataImporter
    DatabaseSetupTest ..> DatabaseSetup
}

' ===== CONNECTIONS =====
Menu --> UserIo
GoverLensApp --> CashFlowDao
GoverLensApp --> ForeisDao
GoverLensApp --> DatabaseSetup

@enduml
